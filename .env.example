# ==========================================
# Legal Metrology Compliance Backend - Environment Variables Template
# ==========================================
# Copy this file to .env and fill in your actual values.
# Never commit .env to version control.
# This file (.env.example) should contain ONLY placeholders.

# Application Settings
APP_NAME="Legal Metrology Compliance API"
APP_ENV="development"
DEBUG=true
HOST="0.0.0.0"
PORT=8000

# Supabase Configuration
# Anon/Publishable key — safe for client-side use, limited permissions
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_KEY="your-supabase-anon-or-publishable-key"
# Service Role key — server-side only, never expose to clients
# Get from: Supabase Dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_KEY="your-supabase-service-role-key"

# Database Connection (Direct PostgreSQL / SQLAlchemy)
# Optional: Set this to use a direct PostgreSQL connection via Supabase connection pooler.
# Leave as-is if using only the Supabase SDK client above.
DATABASE_URL="postgresql://postgres:your-password@db.your-project-id.supabase.co:5432/postgres"
